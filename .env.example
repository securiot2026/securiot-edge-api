# Path to the local SQLite buffer file used by the Edge API.
EDGE_DB_PATH=edge.db

# Shared secret the device (or simulator) must send in the X-Device-Key header
# on every POST /ingest request. Requests without a matching header are rejected.
DEVICE_SHARED_SECRET=change-me

# Base URL of the Cloud API this Edge instance relays buffered readings to.
CLOUD_API_URL=http://localhost:5000

# API key the Edge API sends as X-Device-Key when calling the Cloud API.
CLOUD_DEVICE_API_KEY=change-me-too

# How often (in seconds) the background relay checks for unsynced readings.
RELAY_INTERVAL_SECONDS=10

# Existing object/person detector used by the door and pan/tilt flow.
DETECTION_BACKEND=mock
YOLO_MODEL_PATH=yolov8n.pt
ALLOWED_OBJECT_CLASS=backpack
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_DEBOUNCE_COUNT=2
DOOR_ACTION_COOLDOWN_SECONDS=30
MAX_CONTENT_LENGTH=2097152

# Optional face-recognition pipeline. It is disabled until both model files
# are supplied locally; weights and biometric data must not be committed.
FACE_RECOGNITION_ENABLED=false
FACE_YOLO_MODEL_PATH=models/yolov8n-face.pt
FACE_YOLO_CONFIDENCE_THRESHOLD=0.5
FACE_YOLO_IOU_THRESHOLD=0.45
FACE_YOLO_INPUT_SIZE=640
FACE_YOLO_MAX_DETECTIONS=10
FACE_YOLO_CLASS_ID=0
FACE_YOLO_DEVICE=cpu

ARCFACE_MODEL_PATH=models/w600k_r50.onnx
ARCFACE_DEVICE=cpu
FACE_IDENTITY_DIR=data/faces
FACE_SIMILARITY_THRESHOLD=0.45
FACE_CROP_MARGIN=0.2
FACE_MINIMUM_ENROLLMENT_IMAGES=3
