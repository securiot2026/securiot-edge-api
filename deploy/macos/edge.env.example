# Copy to ~/.securiot/edge.env and chmod 600. Never commit the real file.
export SECURIOT_EDGE_DIR="$HOME/path/to/securiot-edge-api"

# Cloud API the Edge sends heartbeats and readings to. Without these two the
# Edge falls back to http://localhost:5000, which is AirPlay on macOS (403).
export CLOUD_API_URL=https://<cloud-api-host>
export CLOUD_DEVICE_API_KEY=<key returned by POST /api/v1/devices/<id>/rotate-key>

# Same value as EDGE_ADMIN_API_KEY in the Cloud API environment (Dokploy).
export EDGE_ADMIN_API_KEY=<random 48 hex characters>
# DEVICE_SHARED_SECRET stays in the repo .env (same value as the Cloud API
# EDGE_DEVICE_SHARED_SECRET, it is what the Setup QR hands to the board).

export DETECTION_BACKEND=yolo
export YOLO_MODEL_PATH=models/yolov8n.pt
export ALLOWED_OBJECT_CLASS=backpack

export FACE_RECOGNITION_ENABLED=true
export FACE_YOLO_MODEL_PATH=models/yolov8n-face.pt
export ARCFACE_MODEL_PATH=models/w600k_r50.onnx
export FACE_IDENTITY_DIR=data/faces
export FACE_YOLO_DEVICE=cpu
export ARCFACE_DEVICE=cpu
