<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.securiot.tunnel</string>
<key>ProgramArguments</key><array><string>/bin/zsh</string><string>/Users/YOU/.securiot/run-tunnel.sh</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>/Users/YOU/.securiot/tunnel.log</string>
<key>StandardErrorPath</key><string>/Users/YOU/.securiot/tunnel.log</string>
</dict></plist>
